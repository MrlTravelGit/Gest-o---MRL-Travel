VAULT_BIND_HOST=127.0.0.1
VAULT_PORT=7443
VAULT_DATA_DIR=C:\ProgramData\MRLTravel\Vault
VAULT_CERT_PATH=C:\ProgramData\MRLTravel\Vault\certificates\vault.crt
VAULT_KEY_PATH=C:\ProgramData\MRLTravel\Vault\certificates\vault.key
VAULT_PUBLIC_ORIGIN=https://mrl-vault.local:7443
VAULT_MAIN_APP_ORIGIN=https://gestao.mrltravel.com.br
VAULT_SESSION_IDLE_MINUTES=10
VAULT_SESSION_MAX_HOURS=8
VAULT_MAX_FILE_MB=25
VAULT_TRASH_DAYS=30
# Credencial do agente e protegida por DPAPI via CLI, nunca nesta configuracao.
VAULT_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VAULT_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA
