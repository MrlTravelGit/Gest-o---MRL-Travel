{
  "name": "@mrl/local-client-vault",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "typecheck": "tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run --root . src/server/security.test.ts",
    "start": "node --env-file-if-exists=.env dist-server/server.js",
    "vault:init": "node --env-file-if-exists=.env dist-server/cli.js init-admin",
    "vault:create-user": "node --env-file-if-exists=.env dist-server/cli.js create-user",
    "vault:set-agent": "node --env-file-if-exists=.env dist-server/cli.js set-agent-credential",
    "vault:backup": "node --env-file-if-exists=.env dist-server/cli.js backup",
    "vault:restore": "node --env-file-if-exists=.env dist-server/cli.js restore",
    "vault:import": "node --env-file-if-exists=.env dist-server/cli.js import-folders",
    "sync": "node --env-file-if-exists=.env dist-server/sync-agent.js"
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "^5.8.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
